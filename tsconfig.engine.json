{
  // O motor, src/report, src/import e a formatação são TypeScript puro: sem DOM, sem Node e sem dependências.
  // Este projeto confere isso: só a biblioteca padrão ES2023 está disponível.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src/engine", "src/report", "src/import", "src/lib/format.ts"],
  "exclude": ["src/engine/__tests__", "src/report/__tests__", "src/import/__tests__"]
}
